---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects, researchInterests, researchThemes, sitePath } from '../data/site';
---

<BaseLayout title="Research · Jiachang Zhang">
  <main class="page-main research-page">
    <PageHeader title="Research" count={researchThemes.length} itemLabel="themes" actionLabel="Selected work" actionHref={sitePath('projects/')} />

    <section class="research-intro">
      <p>
        I am interested in building agents that can learn from interactions, failures,
        and visual dynamics rather than only from final outcomes.
      </p>
      <div class="chips">
        {researchInterests.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="theme-grid">
      {researchThemes.map((theme, index) => (
        <article class="research-theme">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h2>{theme.title}</h2>
          <p>{theme.description}</p>
        </article>
      ))}
    </section>

    <section class="work-ledger">
      <div class="section-heading">
        <div>
          <p class="kicker">Current work</p>
          <h2>Work in progress, stated plainly.</h2>
        </div>
      </div>
      <div class="work-ledger-list">
        {projects.map((project) => (
          <article>
            <div>
              <p class="project-status">{project.status}</p>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <div class="tags">
              {project.tags.map((tag) => <span class="project-tag">{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
