---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects, sitePath } from '../data/site';
---

<BaseLayout title="Projects · Jiachang Zhang">
  <main class="page-main projects-page">
    <PageHeader title="Projects" count={projects.length} itemLabel="research projects" actionLabel="Research CV" actionHref={sitePath('files/Jiachang_Zhang_Research_CV.pdf')} />

    <section class="project-grid">
      {projects.map((project) => (
        <article class:list={['project-card', 'project-card-full', { 'project-card-text': !project.image }]}>
          {project.image && (
            <img class="project-card-image" src={sitePath(project.image)} alt={project.imageAlt} loading="lazy" />
          )}
          {project.image && <div class="project-card-overlay"></div>}
          <div class="project-card-body">
            <p class="project-status">{project.status}</p>
            <h2>{project.title}</h2>
            <p>{project.summary}</p>
            <div class="tags">
              {project.tags.map((tag) => <span class="project-tag">{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </section>

    <p class="project-disclosure">
      Selected project visuals are shown for research context. Source code and full experimental materials are not public.
    </p>
  </main>
</BaseLayout>
